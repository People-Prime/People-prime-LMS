# People Prime LMS - Global Git Ignore

# Secrets & Environment variables
.env
*.env
.env.*
backend/.env

# Python / Django
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/__pycache__/
backend/*/__pycache__/
backend/*/*/__pycache__/

# Virtual Environment
.venv/
venv/
env/
ENV/
backend/.venv/

# Django media, static, databases
media/
staticfiles/
*.sqlite3
backend/media/
backend/staticfiles/

# Node / Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Backups & Dumps
backups/
backup_*/
*.dump
*.dump.*
backup_*.json
cookies.txt
scratch/
scratch_*.py

# IDE and OS files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

